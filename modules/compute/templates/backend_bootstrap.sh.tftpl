#!/bin/bash
## Placeholder bootstrap for the ${tier} tier (${environment}). It installs no application.
set -euo pipefail

LOG_FILE=/var/log/bootstrap.log
exec >>"$LOG_FILE" 2>&1

echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) bootstrap started: tier=${tier} environment=${environment}"

## TODO: install the backend runtime (runtime and version not yet decided).
## TODO: fetch and deploy the backend artifact (delivery mechanism not yet decided).
## TODO: serve the health-check path configured on the ALB target group; none is verified yet.
## TODO: obtain database credentials from a secrets manager once the database module exists.
## TODO: ship the bootstrap log to CloudWatch Logs with the CloudWatch agent.

echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) bootstrap finished: no application installed"
