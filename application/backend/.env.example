# Placeholders only. Never commit real values. Copy to .env for local development (.env is gitignored).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# "memory" runs with seeded in-memory data (no database). "mysql" uses the DB_* settings below.
STORE=memory

# Required in production: at least 32 random characters. In development a random one is generated per start.
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more

# Comma-separated browser origins allowed to call the API. Leave empty when the API is served
# same-origin behind the frontend web server.
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API so client IPs and rate limits use X-Forwarded-For correctly.
# 0 locally; 4 on the AWS path (CloudFront, public ALB, frontend Nginx, internal ALB).
TRUST_PROXY=0

# Set to false only for local HTTP development. Must be true in production (HTTPS via CloudFront).
COOKIE_SECURE=false

# MySQL (STORE=mysql). In AWS the password comes from the RDS-managed Secrets Manager secret and must
# be injected at process start by the deployment mechanism; never put it in this file or in the repo.
DB_HOST=
DB_PORT=3306
DB_NAME=appdb
DB_USER=
DB_PASSWORD=
# Path to a CA bundle that validates the RDS certificate (for example the AWS RDS global bundle).
DB_SSL_CA_PATH=
# Allow an unencrypted DB connection (local development only).
DB_SSL_DISABLED=false

# Optional: create an admin when seeding. Choose your own values; there are no default credentials.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

