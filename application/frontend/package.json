{
  "name": "oriel-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Oriel demo storefront (React, TypeScript, Vite)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
